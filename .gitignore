# Build output and dependencies
node_modules/
dist/
.cache/

# macOS cruft
.DS_Store
**/.DS_Store

# Licensed webfonts. Adobe Caslon Pro is a desktop-licensed face and this repo
# is public, so the binaries stay out of git. Regenerate from the source OTFs:
#   python3 -m fontTools.ttLib.woff2 compress -o NAME.woff2 NAME.otf
static/assets/fonts/*.woff2

# Open Web Analytics lives only on the server (live DB credentials, visitor
# logs). Never commit it.
analytics/

# Notes for me about the site (the audit and the suggestions list). They quote
# contact details and draft decisions, so they stay out of the public repo.
AUDIT.md
SUGGESTIONS.md

# Local backups and editor noise
*.bak
*.graphite-bak
*.swp
*.swo
.vscode/
.idea/

# Secrets, in case anything like this ever lands here
.env
*.env
credentials
*credential*
*secret*

# Python bytecode
__pycache__/
*.pyc
