# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Disable directory listing
Options -Indexes

# Compress text responses. The SPA shell is ~120 KB uncompressed and was being
# sent raw; gzip cuts it to roughly a fifth. Applies to PHP output too.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# Block direct access to OWA config file (contains DB credentials)
<Files "owa-config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# Block OS/editor junk and dependency manifests. .DS_Store files leak local
# filenames and directory structure; composer manifests advertise every
# dependency and its exact version, which is a ready-made CVE checklist.
# Deliberately NOT a blanket dotfile deny: that would break /.well-known/
# and with it ACME certificate renewal.
<FilesMatch "(^\.DS_Store$|^\._|^composer\.(json|lock)$|^installed\.json$|\.(bak|orig|swp|tmp)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Try to restore entity tags. The host currently serves FileETag None (static
# assets have no ETag either), so this may be overridden server-side — in which
# case Last-Modified continues to carry revalidation, which is verified working.
# FileETag is a core directive and needs AllowOverride FileInfo, which this
# file already relies on for AddHandler/RewriteRule.
FileETag MTime Size

# SPA Routing
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.samuel-stephens\.com$ [NC]
RewriteRule ^(.*)$ https://samuel-stephens.com/$1 [R=301,L]

# Deny direct access to third-party library code and OWA's private data.
# These MUST precede the "serve actual files directly" rule below: that rule
# ends in [L], so for files that genuinely exist on disk (which these do) a
# deny placed after it would never be evaluated.
# vendor/*.php are libraries, not entry points, yet were directly executable;
# owa-data holds only caches and logs (nothing is referenced client-side) and
# its error log was publicly readable.
RewriteRule ^analytics/vendor/ - [F,L]
RewriteRule ^analytics/owa-data/ - [F,L]

# Serve actual files directly (json, md, images, pdf, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Allow analytics directory to be handled by PHP (Open Web Analytics)
RewriteRule ^analytics(/|$) - [L]

# Unlisted HTML CV: clean URL /sdvscvhtml -> /sdvscvhtml.html
# Must precede the SPA fallback or the router would swallow it.
RewriteRule ^sdvscvhtml/?$ /sdvscvhtml.html [L]

# Bot detection — serve SEO-friendly HTML to search crawlers.
# The -f guard means a missing seo.php degrades to the SPA instead of looping.
RewriteCond %{HTTP_USER_AGENT} (Googlebot|bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Applebot|Pinterestbot|redditbot|Slackbot|SkypeUriPreview|Embedly|Iframely|Mastodon) [NC]
RewriteCond %{DOCUMENT_ROOT}/seo.php -f
RewriteRule ^ /seo.php [L,QSA]

# Everything else goes to the SPA via index.php, which injects per-page
# link-preview metadata before serving index.html. Routing through PHP means
# previews work for every client, including Apple Messages (which fetches with
# a plain Safari user-agent and so cannot be detected by the rule above).
#
# The -f guard is load-bearing: without it, if index.php is ever absent
# (mid-upload, failed sync, accidental delete) this rule would rewrite to a
# nonexistent file, re-enter the ruleset, and loop until Apache's 10-redirect
# limit — returning 500 on EVERY page. With the guard we fall through to the
# static index.html below and the site keeps serving.
# QSA flag preserves query strings (needed for Giscus auth callback)
RewriteCond %{DOCUMENT_ROOT}/index.php -f
RewriteRule ^ /index.php [L,QSA]

# Safety net: plain SPA if index.php is unavailable for any reason.
RewriteRule ^ /index.html [L,QSA]
</IfModule>

# Prefer the metadata-injecting front controller for directory requests.
# Wrapped in IfModule so the site cannot 500 if mod_dir is unavailable.
<IfModule mod_dir.c>
  DirectoryIndex index.php index.html
</IfModule>
