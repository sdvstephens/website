# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Disable directory listing
Options -Indexes

# Block direct access to OWA config file (contains DB credentials)
<Files "owa-config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# SPA Routing
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.samuel-stephens\.com$ [NC]
RewriteRule ^(.*)$ https://samuel-stephens.com/$1 [R=301,L]

# Serve actual files directly (json, md, images, pdf, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Allow analytics directory to be handled by PHP (Open Web Analytics)
RewriteRule ^analytics(/|$) - [L]

# Bot detection — serve SEO-friendly HTML to crawlers
RewriteCond %{HTTP_USER_AGENT} (Googlebot|bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Applebot|Pinterestbot|redditbot) [NC]
RewriteRule ^ /seo.php [L,QSA]

# Everything else goes to SPA (including directory paths like /blog)
# QSA flag preserves query strings (needed for Giscus auth callback)
RewriteRule ^ /index.html [L,QSA]
</IfModule>
