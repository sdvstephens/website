# .htaccess for the static build (upload with the contents of dist/).
# Replaces the single-page-app rules: there is no index.php, meta.php,
# seo.php or crawler rule any more, because every page is a finished HTML
# file.

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

Options -Indexes -MultiViews
# index.php is for the Open Web Analytics dashboard (/analytics/); every
# page of the site itself is an index.html.
DirectoryIndex index.html index.php
# A real 404 status for missing pages (the old setup answered 200).
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/atom+xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_headers.c>
  # Font files never change in place: cache for a year.
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages: always revalidate, so a new build shows up at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
FileETag MTime Size

# Open Web Analytics: same protections as the current .htaccess.
<Files "owa-config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>
<FilesMatch "(^\.DS_Store$|^\._|^composer\.(json|lock)$|^installed\.json$|\.(bak|orig|swp|tmp)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteCond %{HTTP_HOST} ^www\.samuel-stephens\.com$ [NC]
RewriteRule ^(.*)$ https://samuel-stephens.com/$1 [R=301,L]

RewriteRule ^analytics/vendor/ - [F,L]
RewriteRule ^analytics/owa-data/ - [F,L]

# Clean URLs: /about serves about.html, /blog/a-dream serves blog/a-dream.html.
# Directories (/blog/, /notes/math-55a/) are handled by DirectoryIndex, and
# Apache's DirectorySlash adds the trailing slash, as it does today.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
