# Course readings and handouts for the critical theory notes. The PDFs are
# copyrighted, so they sit behind a password (HTTP Basic auth over HTTPS)
# and stay out of the public git repo; only this file is committed.
#
# .htpasswd lives next to this file on the server (it is gitignored, and
# Apache never serves .ht* files). Make or change the login with
#   htpasswd -cB notes/critical-theory/readings/.htpasswd reader
# then publish. AuthUserFile needs the absolute path on the server.

AuthType Basic
AuthName "Critical Theory readings"
AuthUserFile /home/edgete7/samuel-stephens.com/notes/critical-theory/readings/.htpasswd
Require valid-user

<Files ".ht*">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# Keep the PDFs out of search engines even for someone who is logged in.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "private, max-age=3600"
</IfModule>
